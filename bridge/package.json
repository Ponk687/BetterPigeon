{
  "name": "bridge",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "bundle": "esbuild index.ts --bundle --platform=node --target=node18 --outfile=dist/bundle.js --format=cjs && pkg dist/bundle.js --target node18-linux-x64 --output ../src-tauri/binaries/bridge-x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "matrix-js-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*",
    "pkg": "*",
    "esbuild": "*"
  }
}